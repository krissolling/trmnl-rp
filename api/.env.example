# Copy to .env and fill in when the Figma token arrives.

# Personal access token from https://www.figma.com/developers/api#access-tokens
# Needs scopes: files:read, projects:read, file_comments:read
FIGMA_TOKEN=

# Team ID from the URL when viewing your team in Figma
# e.g. https://www.figma.com/files/team/1234567890/...  ->  FIGMA_TEAM_ID=1234567890
FIGMA_TEAM_ID=

# When set to "1", skip Figma calls and return canned mock data.
# Auto-enabled if FIGMA_TOKEN is empty.
MOCK=

# Forces the mock day when MOCK=1. One of: mon tue wed thu fri auto
# "auto" uses today's real weekday. Default: auto
MOCK_DAY=auto

# Local dev server port
PORT=3000
